# Demo Form Integration
NEXT_PUBLIC_DEMO_API_ENDPOINT=https://api.churchday.com/api/demo-requests

# Analytics
NEXT_PUBLIC_GA_ID=

# Meta Ads. Both are safe to expose — they are public identifiers that only
# work on a domain the ad account already owns. Set them in the Vercel project
# (Production only, so previews stay out of the ad account's data).
# Events Manager > Data sources > your pixel > the numeric ID under the name.
NEXT_PUBLIC_META_PIXEL_ID=
# Business settings > Brand safety > Domains > church-day.com > Meta-tag
# verification — the value of the content="..." attribute, nothing else.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Form Service (Formspree, Getform, etc.)
NEXT_PUBLIC_FORM_SERVICE_KEY=
